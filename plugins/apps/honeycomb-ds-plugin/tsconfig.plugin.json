{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@penpot/plugin-types": ["../../libs/plugin-types/index.d.ts"]
    }
  },
  "files": ["src/plugin.ts"],
  "include": [
    "src/builders/**/*.ts",
    "src/lib/**/*.ts",
    "src/generated/**/*.json",
    "../../libs/plugin-types/index.d.ts"
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
